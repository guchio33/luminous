{
  "name": "luminous",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @luminous/web dev",
    "dev:api": "pnpm --filter @luminous/api dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @luminous/web build",
    "build:api": "pnpm --filter @luminous/api build",
    "start": "pnpm -r --parallel start",
    "start:web": "pnpm --filter @luminous/web start",
    "start:api": "pnpm --filter @luminous/api start",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:web": "pnpm --filter @luminous/web test",
    "test:api": "pnpm --filter @luminous/api test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "husky": "^9",
    "lint-staged": "^16",
    "prettier": "^3",
    "typescript": "^5",
    "typescript-eslint": "^8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
